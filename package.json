{
  "name": "payment-gateway",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
  "dev:up":    "docker-compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up",
  "dev:down":  "docker-compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev down",
  "dev:logs":  "docker-compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev logs -f",
  "dev:reset": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev down -v",

  "test:up":    "docker-compose -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test up",
  "test:down":  "docker-compose -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test down",
  "test:reset": "docker-compose -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test down -v",

  "prod:up":   "docker-compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up",
  "prod:down": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod down"
},
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}