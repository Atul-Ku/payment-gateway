# ── Environment ────────────────────────────
NODE_ENV=development

# ── PostgreSQL ─────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────
REDIS_PORT=6379

# ── Kafka (KRaft) ──────────────────────────
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_CLUSTER_ID=

# ── Auth ───────────────────────────────────
# Min 32 characters
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Card Vault ─────────────────────────────
# Must be exactly 64 hex characters (32 bytes)
CARD_ENCRYPTION_KEY=

# ── Services ───────────────────────────────
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002
CARD_VAULT_PORT=3003
TRANSACTION_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
FRAUD_SERVICE_PORT=3006
SETTLEMENT_SERVICE_PORT=3007
MERCHANT_SERVICE_PORT=3008

# ── Logging ────────────────────────────────
LOG_LEVEL=debug